# Server-only unless prefixed NEXT_PUBLIC_. Never commit real values.
# In Vercel, add every secret as a Sensitive environment variable.

# --- Database (Neon) -------------------------------------------------------
# Both use the least-privilege app role (see prisma/sql/app-role.sql), not the Neon owner.
# Pooled (hostname contains -pooler): used by the app at runtime.
DATABASE_URL="postgresql://APP_ROLE:PASSWORD@ep-XXXX-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&connect_timeout=15"
# Direct (no -pooler): used by the Prisma CLI and the build-time drift check.
DIRECT_URL="postgresql://APP_ROLE:PASSWORD@ep-XXXX.REGION.aws.neon.tech/neondb?sslmode=verify-full&connect_timeout=15"

# --- Clerk: business login only. The public intake form works without it. ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Uploadthing: vaccination record photos ---------------------------------
UPLOADTHING_TOKEN=

# --- Resend: transactional email ---------------------------------------------
RESEND_API_KEY=
# Must be a verified sender domain in Resend
EMAIL_FROM="Pawperwork <noreply@pawperwork.pet>"
# Local development only: print emails to the console and treat them as sent,
# so the reminder cron can be exercised without a Resend key. Ignored in production.
# EMAIL_TRANSPORT="console"

# --- Reminder cron -----------------------------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer ...` to
# GET /api/cron/vax-reminders. Generate with: openssl rand -hex 32
CRON_SECRET=

# Absolute base URL, used to build intake links in emails and the dashboard.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Optional: PostHog product analytics (docs/modules/analytics-posthog.md) ---
# Public by design: a project token can only send events, not read them.
# Leave both empty to keep analytics off. One PostHog project per tool.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
