# ---------------------------------------------------------------------------
# Pet Intake & Vax Tracker — environment
# Copy to .env and fill in. Never commit .env.
# Values for everything below the database come from `stripe projects add`
# (Stripe Projects syncs provider credentials into your environment).
# ---------------------------------------------------------------------------

# Postgres (Neon or Supabase in production; `npx prisma dev` locally)
DATABASE_URL="postgresql://user:password@host:5432/pet_intake?schema=public"

# Clerk — business login only. The public intake form is unauthenticated.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Uploadthing — vaccination record photos
UPLOADTHING_TOKEN=""

# Resend — transactional email
RESEND_API_KEY=""
# Must be a verified sender domain in Resend
EMAIL_FROM="Pet Intake <noreply@example.com>"

# Shared secret for GET /api/cron/vax-reminders. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""

# Absolute base URL, used to build intake links in emails
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Local development only: print emails to the console and treat them as sent,
# so the reminder cron can be exercised without a Resend key. Ignored in
# production. Unset this once RESEND_API_KEY is configured.
# EMAIL_TRANSPORT="console"
